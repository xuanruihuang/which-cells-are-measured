# Copy to config.env and edit. Read by code/config.py; environment variables of the same name take precedence.
# Only locations are set here. Scripts that take paths as command-line arguments do not read this file.

# DepMap Public 24Q4 CRISPRGeneEffect.csv (median gene effect over lines defines the essentiality strata).
DEPMAP=/path/to/CRISPRGeneEffect_24Q4.csv

# The analyses ran on two machines whose output trees reuse folder names (both have budget/ and ci/), so they are kept
# as two roots. FATE_ROOT holds the outputs of the hESC, K562, RPE1 and CD4 analyses (budget/, budget_cd4/,
# budget_d8/, kdgroup/, samescale_out/, pan_libnorm/, phase_decomp/, xctx/, ci/, mixture/, ...).
FATE_ROOT=/path/to/work/fate_iu
# CC_ROOT holds the Jurkat / HepG2 budget, the Maffa, Drepanos and VCC H1 analyses, the C1 table and libshare/.
CC_ROOT=/path/to/work/cross_context

# hESC per-cell knockdown-group aggregates written by pan_extract_kdgroup.py.
PAN_KDGROUP=/path/to/work/pan_agg_kdgroup

# hESC aggregates by guide parity with raw counts, written by pan_extract_guide.py (the same folder that other scripts
# take as the <pan_agg_guide_raw dir> argument).
PAN_GUIDE_RAW=/path/to/work/pan_agg_guide_raw

# X-Atlas/Orion download (orion_extract.py): X-Atlas-Orion/ from Hugging Face and the preprocessed gene axis and control
# means in PIE_x_atlas_orion/preprocessed/ (see README, "Inputs made outside this repository").
ORION_ROOT=/path/to/data/orion

# CD4 donor 1 resting per-target table and pseudobulk (inputs of fate_libshare_summary.py; see README, "Inputs made
# outside this repository").
CD4_PERT_TABLE=${CC_ROOT}/explore_W/cd4_rest_pert_table.npz
CD4_PSEUDOBULK=/path/to/cd4_rest_pseudobulk.npz
